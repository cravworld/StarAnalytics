# Supabase Postgres connection (Project Settings → Database → Connection string → URI).
# DATABASE_URL = pooled connection, port 6543, pgbouncer=true — the app's runtime queries.
# DIRECT_URL   = direct connection, port 5432 — `prisma migrate` needs this one; migrations
#                don't work reliably through the pgbouncer pooler.
DATABASE_URL="postgresql://postgres:password@localhost:5432/staranalytics"
DIRECT_URL=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand--base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shared secret the 3 cron routes (poll-hashtags, prune-raw-payloads,
# backfill-sentiment) require in an `Authorization: Bearer <secret>` header.
# Each route fails closed (500) if this is unset — generate with
# `openssl rand -base64 32` and set the same value in Vercel's cron config.
CRON_SECRET=""

# Data-minimization cron (prune-raw-payloads), DATA-PRIVACY.md "Retention".
# Both are policy decisions, not engineering ones — defaulted to 90 days each
# since nothing in the codebase implied a real number; change if wrong for how
# this data actually gets used.
# RAW_PAYLOAD_RETENTION_DAYS — nulls posts.raw / post_comments.raw (the full
#   Apify scrape blob; never read back after ingest-time extraction).
# COMMENT_RETENTION_DAYS — nulls post_comments.text / .author_handle (the one
#   structured-data column holding a third party's — the commenter's, not the
#   tracked account's — personal data; only ever read once, by the sentiment
#   classifier, and never again after).
RAW_PAYLOAD_RETENTION_DAYS="90"
COMMENT_RETENTION_DAYS="90"

# Max comments requested per post from apify/instagram-comment-scraper (src/lib/providers/
# apify-public-content.ts). No hard ceiling on the actor's side — real output is bounded
# only by how many comments Instagram exposes to a logged-out viewer, not by this number.
# Cost is pay-per-result (measured $2.30/1000 comments as of 2026-07-31 on this account's
# Starter plan). Was briefly uncapped (100000) the same day; reverted to 200 after large
# comment threads both burned a $29/month budget in under a day and pushed individual
# scrapes long enough to trigger silent invocation deaths (stuck locks, no error logged).
COMMENTS_PER_POST_LIMIT="200"

# Login allowlist — StarAnalytics is Confidential; plain Google OAuth is not enough.
# Set ONE of these before deploying anywhere real:
ALLOWED_EMAIL_DOMAIN=""
ALLOWED_EMAILS=""

# Per-provider data mode: mock | live.
# Flip DATA_MODE_APIFY to "live" once APIFY_TOKEN below is set — that's the switch that
# makes PublicContentProvider resolve to the real implementation instead of Mock.
DATA_MODE_INSTAGRAM="mock"
DATA_MODE_APIFY="mock"
DATA_MODE_SENTIMENT="mock"
DATA_MODE_NOTIFIER="mock"
DATA_MODE_YOUTUBE="mock"

# apify.com → Settings → Integrations → API token
APIFY_TOKEN=
# Apify spend controls — see APIFY-USAGE-AUDIT.md. All optional; defaults shown.
# Hard per-run charge cap, enforced by Apify itself via maxTotalChargeUsd.
APIFY_MAX_CHARGE_USD_PER_RUN=6
# Monthly headroom we refuse to spend into, so the account never reaches its plan cap.
APIFY_MONTHLY_RESERVE_USD=1
# Comment scraping: resultsLimit is PER URL, so run cost is posts x COMMENTS_PER_POST_LIMIT.
APIFY_COMMENT_POSTS_PER_RUN=10
APIFY_COMMENT_POSTS_PER_INVOCATION=20
APIFY_COMMENT_RUN_WAIT_MS=180000
COMMENTS_PER_POST_LIMIT=200
# Biggest recurring line item: this many results per hashtag, every poll-hashtags tick.
APIFY_HASHTAG_RESULTS_LIMIT=150
APIFY_HANDLE_POSTS_LIMIT=50
APIFY_DATASET_ITEM_LIMIT=10000""

# Which Apify actor(s) back PublicContentProvider's live implementation.
# APIFY_ACTOR_HASHTAG  — apify/instagram-hashtag-scraper, used by scrapeByHashtag.
# APIFY_ACTOR_PROFILE  — apify/instagram-profile-scraper, used for followers/display-name
#                        snapshots (fetchProfileSnapshot).
# APIFY_ACTOR_POST     — apify/instagram-post-scraper, used by both scrapeByHandle's
#                        post-history call and scrapeByUrls (single `username` input
#                        field accepts usernames, profile URLs, or post URLs).
APIFY_ACTOR_HASHTAG=""
APIFY_ACTOR_PROFILE=""
APIFY_ACTOR_POST=""
# apify/instagram-comment-scraper — comment ingestion for the sentiment pipeline (Phase 4).
# Only invoked for posts entering sentiment classification, never for every scraped post.
APIFY_ACTOR_COMMENTS=""

# Phase 4 sentiment: direct Claude API call (plain fetch, no SDK/orchestration infra).
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=""
ANTHROPIC_SENTIMENT_MODEL="claude-sonnet-5"

# Cross-provider sentiment fallback (2026-07-31): if Claude's call fails for any reason
# (rate limit, exhausted credit balance, network error), the pipeline automatically retries
# with OpenAI, then Gemini. All three are required for the fallback to actually cover a
# Claude outage — an unset key just means that leg of the chain throws immediately and the
# next provider is tried. platform.openai.com / aistudio.google.com for keys.
OPENAI_API_KEY=""
OPENAI_SENTIMENT_MODEL="gpt-5.6-terra"
GEMINI_API_KEY=""
GEMINI_SENTIMENT_MODEL="gemini-3.5-flash"

# Phase 5 fan-page alerts: real delivery via Resend (plain fetch, no SDK). Flip
# DATA_MODE_NOTIFIER to "live" once these are set — stays on the mock/console notifier
# until then. ALERT_EMAIL_FROM must be a sender Resend will actually accept: either a
# domain you've verified with Resend, or their sandbox address "onboarding@resend.dev"
# (sandbox mode only delivers to the email your Resend account was signed up with).
RESEND_API_KEY=""
ALERT_EMAIL_FROM=""
ALERT_EMAIL_TO=""

# Phase 7 self-account dashboard: Instagram Graph API (Instagram Login), direct fetch, no
# SDK. Gated on Meta App Review — a Business/Creator IG account, a registered Meta app,
# and approved permissions (instagram_basic, instagram_manage_insights) are prerequisites.
# INSTAGRAM_ACCESS_TOKEN         — long-lived access token for that app/account.
# INSTAGRAM_BUSINESS_ACCOUNT_ID  — the IG User ID (graph.facebook.com/{id}), not the @handle.
# Flip DATA_MODE_INSTAGRAM to "live" once both are set.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# YouTube (competitor/fan-channel tracking) — official Data API v3, direct fetch, no SDK.
# Just a self-service API key (no app-review process): console.cloud.google.com → enable
# "YouTube Data API v3" → Credentials → create an API key. Flip DATA_MODE_YOUTUBE to "live"
# once set. Own-channel private analytics (impressions, demographics) would need a
# separate OAuth-based YouTube Analytics API integration — not built yet, deferred like
# Phase 7's Meta gate.
YOUTUBE_API_KEY=""
