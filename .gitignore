# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/

.vercel
.env*

# claude code — local settings and throwaway worktrees (full repo copies)
/.claude/

# Local capture run log — written by scripts/bms-capture.mjs on the operator machine.
bms-capture.log

# Operator working files — the client's own source documents (influencer lists, page
# exports, the brief) and the spreadsheets derived from them. Deliberately untracked
# rather than committed: they carry real names and handles, which DATA-PRIVACY.md's
# minimisation posture keeps out of a permanent git history, and nothing in the app
# reads them — they are the input a person formats by hand before uploading. The one
# tracked derivative is reference/bethlehem-kudumba-unit-theatres.txt, which holds
# theatre names only.
/files/
