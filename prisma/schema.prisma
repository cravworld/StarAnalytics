// StarAnalytics — consolidated schema (build plan §3).
// Migrated against a live Supabase project — see prisma/migrations/ for history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pgbouncer) connection — Supabase's pooled port 6543
  // doesn't support the prepared statements Prisma's migration engine relies on.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  team
  agency_viewer
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      UserRole @default(team)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum PostSource {
  self
  competitor
  agency
  fanpage
  campaign
}

// Instagram-only originally — YouTube added as a second platform. Kept as an
// extensible enum (not a boolean) so a third platform is additive, not another migration.
enum Platform {
  instagram
  youtube
}

model Post {
  id            String     @id @default(uuid())
  source        PostSource
  // Platform-neutral despite the name, kept as-is (not renamed) to avoid touching every
  // one of its 9 call sites across the ingestion pipeline on a table with real production
  // data — see the multi-platform migration notes. Holds a YouTube video ID too now.
  platform      Platform   @default(instagram)
  igShortcode   String?    @map("ig_shortcode")
  externalUrl   String?    @map("external_url")
  authorHandle  String?    @map("author_handle")
  mediaType     String?    @map("media_type")
  caption       String?
  postedAt      DateTime?  @map("posted_at")
  scrapedAt     DateTime   @default(now()) @map("scraped_at")

  reach    Int?
  likes    Int?
  comments Int?
  saves    Int?
  shares   Int?

  campaignId   String? @map("campaign_id")
  campaign     Campaign? @relation(fields: [campaignId], references: [id])
  agencyId     String? @map("agency_id")
  agency       Agency? @relation(fields: [agencyId], references: [id])
  fanPageId    String? @map("fan_page_id")
  fanPage      FanPage? @relation(fields: [fanPageId], references: [id])
  competitorId String? @map("competitor_id")
  competitor   CompetitorAccount? @relation(fields: [competitorId], references: [id])

  raw Json?

  sentiment          Sentiment?
  agencyPostScores   AgencyPostScore[]
  postComments       PostComment[]
  alerts             Alert[]

  // Composite, not single-column: a YouTube video ID and an Instagram shortcode occupy the
  // same string space and could theoretically collide. Every existing row defaults to
  // platform=instagram, so this is equivalent to the old single-column @unique for current
  // data — additive, non-destructive.
  @@unique([platform, igShortcode])
  @@map("posts")
}

model PostComment {
  id           String    @id @default(uuid())
  postId       String    @map("post_id")
  post         Post      @relation(fields: [postId], references: [id])
  igCommentId  String?   @map("ig_comment_id")
  // Nullable: both this and authorHandle are nulled out by the prune-raw-payloads cron
  // once COMMENT_RETENTION_DAYS has passed — see that route for why (structured-data
  // retention policy, DATA-PRIVACY.md "Retention"). The row itself (id/postId/scrapedAt)
  // is kept so comment counts stay accurate; only the third-party commenter's text and
  // handle are cleared.
  authorHandle String?   @map("author_handle")
  text         String?
  postedAt     DateTime? @map("posted_at")
  scrapedAt    DateTime  @default(now()) @map("scraped_at")
  raw          Json?

  sentiment CommentSentiment?

  @@map("post_comments")
}

// Per-comment sentiment — separate from the post-level `Sentiment` model (which blends a
// post's caption + a sample of its comments into one aggregate row for the existing
// campaign dashboards) so hater/repeat-offender detection has a real per-commenter signal
// to work from, without touching that existing aggregate or its call sites.
model CommentSentiment {
  postCommentId String      @id @map("post_comment_id")
  postComment   PostComment @relation(fields: [postCommentId], references: [id])
  // Denormalized at classification time, not read from post_comments.author_handle later:
  // that column gets nulled by the prune-raw-payloads cron after COMMENT_RETENTION_DAYS,
  // but classification always happens well inside that window, so this is a snapshot taken
  // before the handle can be pruned — without it, a hater registry would lose attribution
  // the moment the retention cron runs.
  authorHandle String?        @map("author_handle")
  label        SentimentLabel
  score        Float
  model        String
  analyzedAt   DateTime       @default(now()) @map("analyzed_at")

  @@map("comment_sentiment")
}

enum ScrapeRunStatus {
  queued
  running
  done
  error
}

model ScrapeRun {
  id         String          @id @default(uuid())
  kind       String
  status     ScrapeRunStatus @default(queued)
  apifyRunId String?         @map("apify_run_id")
  startedAt  DateTime?       @map("started_at")
  finishedAt DateTime?       @map("finished_at")
  itemCount  Int?            @map("item_count")
  error      String?

  @@map("scrape_runs")
}

enum CampaignStatus {
  live
  planned
}

model Campaign {
  id        String         @id @default(uuid())
  name      String
  status    CampaignStatus
  hashtags  String[]
  startDate DateTime?      @map("start_date")
  endDate   DateTime?      @map("end_date")
  type      String?

  posts         Post[]
  agencies      Agency[]
  events        CampaignEvent[]
  buzzSnapshots CampaignBuzzSnapshot[]

  @@map("campaigns")
}

// Milestones a campaign owner logs by hand (trailer drop, premiere, theatrical release,
// press event, ...) — deliberately free-text `label`, not an enum, same "don't model a
// controlled vocabulary you don't need yet" choice keyword trends already made. Read by
// the campaign detail page's timeline card and cross-referenced against
// getCampaignDetail's sentimentTrend to answer "did this event move sentiment/buzz."
model CampaignEvent {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  label      String
  eventDate  DateTime @map("event_date")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([campaignId])
  @@map("campaign_events")
}

// Daily snapshot of a live campaign's buzz score — computeBuzzScore() itself stays
// stateless/pure (buzzScore.ts), this is the history it never had: buzz score is
// recomputed live on every page load with nothing persisted anywhere. Same shape/reasoning
// as AccountSnapshot (follower history) — captured by a dedicated cron
// (api/cron/snapshot-buzz), not on page view, so a campaign nobody happens to check for a
// week still gets a real daily data point rather than a gap.
model CampaignBuzzSnapshot {
  id                 String   @id @default(uuid())
  campaignId         String   @map("campaign_id")
  campaign           Campaign @relation(fields: [campaignId], references: [id])
  score              Int
  sizeComponent      Int      @map("size_component")
  // Nullable exactly like BuzzScoreResult.components.sentiment — null means "excluded from
  // this day's score, no classified posts yet," not zero. Stored as-is, never faked.
  sentimentComponent Int?     @map("sentiment_component")
  momentumComponent  Int      @map("momentum_component")
  capturedAt         DateTime @default(now()) @map("captured_at")

  @@index([campaignId, capturedAt])
  @@map("campaign_buzz_snapshots")
}

model Agency {
  id         String  @id @default(uuid())
  name       String
  colourHex  String  @map("colour_hex")
  campaignId String? @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  posts             Post[]
  agencyPostScores  AgencyPostScore[]

  @@map("agencies")
}

model CompetitorAccount {
  id            String    @id @default(uuid())
  platform      Platform  @default(instagram)
  // Kept as igHandle (not renamed to `handle`) for the same reason as Post.igShortcode —
  // holds a YouTube channel handle too now, but renaming touches every call site for a
  // cosmetic win. See the multi-platform migration notes.
  igHandle      String    @map("ig_handle")
  displayName   String?   @map("display_name")
  followers     Int?
  addedBy       String?   @map("added_by")
  lastScrapedAt DateTime? @map("last_scraped_at")

  posts Post[]

  @@unique([platform, igHandle])
  @@map("competitor_accounts")
}

model FanPage {
  id            String    @id @default(uuid())
  platform      Platform  @default(instagram)
  igHandle      String    @map("ig_handle")
  displayName   String?   @map("display_name")
  followers     Int?
  lastCheckedAt DateTime? @map("last_checked_at")
  isActive      Boolean   @default(true) @map("is_active")
  isVerifiedFan Boolean   @default(false) @map("is_verified_fan")

  posts  Post[]
  alerts Alert[]

  @@unique([platform, igHandle])
  @@map("fan_pages")
}

// One row per (platform, handle) every time a competitor/fan-page follower count is
// refreshed — CompetitorAccount.followers and FanPage.followers stay single overwritten
// snapshots (unchanged), this is the history neither of them keeps. Deliberately one shared
// table keyed by (platform, igHandle) rather than a row on each model: both are refreshed by
// the same cron (poll-hashtags -> refreshStaleCompetitors/refreshStaleFanPages), a handle can
// in principle be both, and a single trend-query shape covers both call sites. No unique
// constraint — the whole point is multiple rows per handle over time.
model AccountSnapshot {
  id         String   @id @default(uuid())
  platform   Platform
  igHandle   String   @map("ig_handle")
  followers  Int
  capturedAt DateTime @default(now()) @map("captured_at")

  @@index([platform, igHandle, capturedAt])
  @@map("account_snapshots")
}

model AgencyPostScore {
  id                     String   @id @default(uuid())
  runId                  String   @map("run_id")
  agencyId               String   @map("agency_id")
  agency                 Agency   @relation(fields: [agencyId], references: [id])
  postId                 String   @map("post_id")
  post                   Post     @relation(fields: [postId], references: [id])
  perfScore              Float    @map("perf_score")
  authScore              Float    @map("auth_score")
  // Nullable: efficiency has no independent signal this phase (no reach/
  // follower/spend data) — see EFFICIENCY_NOT_EVALUATED_REASON in
  // src/lib/scoring/types.ts. Null, never a placeholder number that would
  // look like a real measurement, and excluded from totalScore accordingly.
  effScore               Float?   @map("eff_score")
  totalScore             Float    @map("total_score")
  flags                  Json
  thresholdConfigVersion Int      @map("threshold_config_version")
  scoredAt               DateTime @default(now()) @map("scored_at")

  @@map("agency_post_scores")
}

enum SentimentLabel {
  pos
  neu
  neg
}

model Sentiment {
  postId     String         @id @map("post_id")
  post       Post           @relation(fields: [postId], references: [id])
  label      SentimentLabel
  score      Float
  keywords   String[]
  model      String
  analyzedAt DateTime       @default(now()) @map("analyzed_at")

  @@map("sentiment")
}

model HashtagSnapshot {
  id           String   @id @default(uuid())
  hashtag      String
  snapshotAt   DateTime @default(now()) @map("snapshot_at")
  postCount    Int      @map("post_count")
  avgEngRate   Float    @map("avg_eng_rate")

  @@map("hashtag_snapshots")
}

model Alert {
  id          String    @id @default(uuid())
  type        String
  fanPageId   String?   @map("fan_page_id")
  fanPage     FanPage?  @relation(fields: [fanPageId], references: [id])
  campaignId  String?   @map("campaign_id")
  // Set for velocity-alert dedup: one Alert per post that triggered it, so
  // re-polling the same hashtag within the window never creates a duplicate.
  postId      String?   @map("post_id")
  post        Post?     @relation(fields: [postId], references: [id])
  message     String
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")
  channel     String?

  @@map("alerts")
}

model ThresholdConfig {
  version   Int      @id
  params    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("threshold_configs")
}

// Row-based mutex for cron routes, not a Postgres session advisory lock — DATABASE_URL
// runs through pgbouncer in transaction-pooling mode (?pgbouncer=true), which can
// interleave different callers' statements on the same underlying connection between
// queries, so a session-held lock wouldn't reliably protect anything. This is a single
// atomic UPDATE instead (see src/lib/cronLock.ts) — safe under transaction pooling because
// it never spans more than one statement. TTL-based rather than a strict acquire/release
// pair alone: if an invocation crashes or times out without releasing, the lock
// self-expires instead of wedging the job forever.
model CronLock {
  name     String    @id
  lockedAt DateTime? @map("locked_at")

  @@map("cron_locks")
}

// --- Scoutline: bulk Instagram-account talent scan (build plan §11) ---
// Standalone tool, not campaign-scoped — an account vetted for one film can surface for
// a future one. Candidates are deduped globally by profileUrlKey; batches only record
// *membership* (which upload brought an account in, and what it arrived with), so
// re-uploading the same handle in a later batch links to the same candidate and its
// full snapshot history rather than creating a duplicate row.

enum ScoutRunStatus {
  queued
  running
  done
  error
}

model ScoutBatch {
  id            String   @id @default(uuid())
  fileName      String   @map("file_name")
  sourceType    String   @map("source_type") // "pdf" | "excel" | "manual"
  expectedCount Int      @map("expected_count")
  parsedCount   Int      @map("parsed_count")
  createdAt     DateTime @default(now()) @map("created_at")

  // Snapshot of ScoutSettings at the moment this batch was started — not a live pointer to
  // "whatever the settings are now". Editing settings after a batch has already been kicked
  // off must never change what that batch's Apify runs asked for or how its scores were
  // computed; it only affects the *next* batch. This is also the transparent record of
  // "what factors actually produced this leaderboard" the settings panel promises.
  // Defaults here match ScoutSettings' own defaults and the actual parameters the very
  // first Scoutline batch ran with (before this table existed) — so backfilling this
  // migration onto that row is accurate, not a placeholder.
  postsToAnalyze     Int     @default(15) @map("posts_to_analyze")
  postTypeFilter     String  @default("all") @map("post_type_filter")
  skipPinnedPosts    Boolean @default(true) @map("skip_pinned_posts")
  dateFilter         String? @map("date_filter")
  weightEngagement   Float   @default(0.4) @map("weight_engagement")
  weightReach        Float   @default(0.3) @map("weight_reach")
  weightConsistency  Float   @default(0.15) @map("weight_consistency")
  weightContentMix   Float   @default(0.15) @map("weight_content_mix")

  entries ScoutBatchEntry[]
  runs    ScoutRun[]

  @@map("scout_batches")
}

model ScoutCandidate {
  id            String   @id @default(uuid())
  igHandle      String   @map("ig_handle")
  // Normalized dedup key (lowercased handle) — mirrors apify-normalize.ts's postUrlKey
  // discipline: the raw URL varies (query params, trailing slash), the handle doesn't.
  profileUrlKey String   @unique @map("profile_url_key")
  firstSeenAt   DateTime @default(now()) @map("first_seen_at")

  batchEntries ScoutBatchEntry[]
  snapshots    ScoutSnapshot[]

  @@map("scout_candidates")
}

// One row per (batch, candidate) — the "supplied" fields are what the source sheet said,
// kept as context even if a later scan finds the account has since renamed itself.
// `deliverable` (STORY/REEL from the source sheet) is deliberately just a String, not an
// enum tied into scoring — soft context to show alongside the score, never a gate on it.
model ScoutBatchEntry {
  id           String         @id @default(uuid())
  batchId      String         @map("batch_id")
  batch        ScoutBatch     @relation(fields: [batchId], references: [id])
  candidateId  String         @map("candidate_id")
  candidate    ScoutCandidate @relation(fields: [candidateId], references: [id])
  rowNumber    Int?           @map("row_number")
  suppliedName String?        @map("supplied_name")
  deliverable  String?

  @@unique([batchId, candidateId])
  @@map("scout_batch_entries")
}

// Tracks a live Apify run for the async handoff (client.ts's own warning: a route killed
// mid-wait orphans a billed run) — a cron polls these rather than a request blocking on them.
model ScoutRun {
  id          String         @id @default(uuid())
  batchId     String         @map("batch_id")
  batch       ScoutBatch     @relation(fields: [batchId], references: [id])
  actorId     String         @map("actor_id")
  apifyRunId  String         @map("apify_run_id")
  datasetId   String         @map("dataset_id")
  status      ScoutRunStatus @default(queued)
  handleCount Int            @map("handle_count")
  startedAt   DateTime       @default(now()) @map("started_at")
  finishedAt  DateTime?      @map("finished_at")
  error       String?

  @@index([status])
  @@map("scout_runs")
}

// Append-only, same discipline as AccountSnapshot — a re-scan adds a row, never overwrites,
// so engagement trend over time is possible later without a schema change.
model ScoutSnapshot {
  id                      String         @id @default(uuid())
  candidateId             String         @map("candidate_id")
  candidate               ScoutCandidate @relation(fields: [candidateId], references: [id])
  runId                   String         @map("run_id")
  followers               Int?
  followersAvailable      Boolean        @map("followers_available")
  postsAnalyzed           Int            @map("posts_analyzed")
  engagementRatePct       Float?         @map("engagement_rate_pct")
  commentRatePct          Float?         @map("comment_rate_pct")
  consistencyScore        Float?         @map("consistency_score")
  postingFrequencyPerWeek Float?         @map("posting_frequency_per_week")
  contentMixClipsPct      Float?         @map("content_mix_clips_pct")
  contentMixCarouselPct   Float?         @map("content_mix_carousel_pct")
  contentMixImagePct      Float?         @map("content_mix_image_pct")
  mostEngagedPostUrl      String?        @map("most_engaged_post_url")
  note                    String?
  raw                     Json
  scrapedAt               DateTime       @default(now()) @map("scraped_at")

  score ScoutScore?

  @@index([candidateId, scrapedAt])
  @@map("scout_snapshots")
}

// Pure downstream computation from a ScoutSnapshot — same "exclude rather than fake
// missing data" discipline as buzzScore.ts. A null component score means that signal
// wasn't measurable for this account (e.g. followers_available=false), not that it
// scored zero.
model ScoutScore {
  id               String        @id @default(uuid())
  snapshotId       String        @unique @map("snapshot_id")
  snapshot         ScoutSnapshot @relation(fields: [snapshotId], references: [id])
  buzzFactor       Int           @map("buzz_factor")
  reachScore       Int?          @map("reach_score")
  engagementScore  Int?          @map("engagement_score")
  consistencyScore Int?          @map("consistency_score")
  contentMixScore  Int?          @map("content_mix_score")
  computedAt       DateTime      @default(now()) @map("computed_at")

  @@map("scout_scores")
}

// Singleton (fixed id="default") — the actor input factors + score weights a new batch
// starts from, editable from the Scoutline settings panel. Not versioned/audited like
// ThresholdConfig — nobody disputes a scan setting the way an agency disputes an
// authenticity score (same reasoning buzzScore.ts gives for its own named-constant
// weights) — but it must still be DB-backed so it's actually editable from the UI rather
// than a redeploy. Each ScoutBatch snapshots these values at creation time (see its own
// comment), so changing this row only ever affects batches started after the change.
model ScoutSettings {
  id                String   @id @default("default")
  // 100, not the actor's own default of 30 — 2026-08-17 direction: "just 15 wont do it
  // justice... atleast latest 100 posts have to be analyzed" (fewer is fine if an account
  // genuinely has fewer, the actor already handles that — this is a ceiling, not a floor).
  postsToAnalyze    Int      @default(100) @map("posts_to_analyze")
  postTypeFilter    String   @default("all") @map("post_type_filter")
  skipPinnedPosts   Boolean  @default(true) @map("skip_pinned_posts")
  dateFilter        String?  @map("date_filter")
  // Retuned 2026-08-17 against the real distribution of the first 202-account batch — see
  // scoreInfluencer.ts's DEFAULT_WEIGHTS comment for the percentiles this was based on.
  // Consistency dropped (it's 0.00 at the median/p75/p90 in real data, so it barely
  // discriminates); the freed weight moved to engagement and content mix.
  weightEngagement  Float    @default(0.45) @map("weight_engagement")
  weightReach       Float    @default(0.3) @map("weight_reach")
  weightConsistency Float    @default(0.05) @map("weight_consistency")
  weightContentMix  Float    @default(0.2) @map("weight_content_mix")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("scout_settings")
}
